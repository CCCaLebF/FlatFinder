# Copy to .env and fill in. Never commit .env.

# --- PostgreSQL (used by docker compose) ---
POSTGRES_DB=flatfinder
POSTGRES_USER=flatfinder
POSTGRES_PASSWORD=change-me

# --- Django ---
# Without Docker: leave DATABASE_URL unset (or sqlite:///db.sqlite3) to use SQLite,
# or point it at your own Postgres. docker compose overrides it to use the `db` service.
# DATABASE_URL=postgres://flatfinder:change-me@localhost:5432/flatfinder
DATABASE_URL=
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1

# --- OneMap (https://www.onemap.gov.sg/apidocs/register) ---
ONEMAP_EMAIL=
ONEMAP_PASSWORD=
