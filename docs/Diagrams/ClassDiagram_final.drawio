        <mxCell id="n_strategy" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fdfdfd;strokeColor=#999999;" value="&lt;b&gt;Strategy pattern&lt;/b&gt;&lt;br&gt;Straight-line distance (ranking, amenity lists) and OneMap walking distance (on demand, UC-04) are interchangeable implementations of DistanceStrategy." vertex="1">
          <mxGeometry height="70" width="330" x="1333" y="900" as="geometry" />
