        <mxCell id="n_persist" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fdfdfd;strokeColor=#999999;" value="&lt;b&gt;Persistent data&lt;/b&gt;&lt;br&gt;«persistent»: database tables (PostgreSQL, or SQLite without Docker), loaded by DataLoader from data.gov.sg.&lt;br&gt;Session: Bookmark and the compare tray (until the browser closes, UC-05, UC-15).&lt;br&gt;Browser localStorage: MapState (UC-13).&lt;br&gt;Per request, not stored: SearchQuery, SearchResult, FitScore, SortOrder, ScoreBounds, NearbyAmenity. Category: five fixed values in code." vertex="1">
          <mxGeometry height="100" width="560" x="120" y="1860" as="geometry" />
        </mxCell>
        <mxCell id="n_access" parent="1" style="shape=note;size=14;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=6;fontSize=10;fillColor=#fdfdfd;strokeColor=#999999;" value="&lt;b&gt;Access control&lt;/b&gt;&lt;br&gt;There are no user accounts or logins (NFR 4), so every user has the same access. The only credentials are the team's OneMap account, kept in server-side configuration. OneMapTokenProvider fetches and refreshes the token, which never reaches the browser." vertex="1">
          <mxGeometry height="100" width="330" x="2960" y="500" as="geometry" />
        </mxCell>
